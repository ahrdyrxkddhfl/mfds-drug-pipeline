# 공공데이터포털 인증키 (https://www.data.go.kr)
MFDS_API_KEY=

# API 요청주소 (End Point + 상세기능 경로)
# 허가정보: 의약품 제품 허가 목록 / 회수: 의약품 회수·판매중지 목록조회
PERMIT_API_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08/getDrugPrdtPrmsnInq08
RECALL_API_URL=https://apis.data.go.kr/1471000/MdcinRtrvlSleStpgeInfoService05/getMdcinRtrvlSleStpgelList05
# PostgreSQL
POSTGRES_USER=mfds
POSTGRES_PASSWORD=
POSTGRES_DB=mfds_drug
POSTGRES_HOST=localhost
# docker-compose가 호스트 5433을 컨테이너 5432에 연결한다.
# 로컬에 설치된 PostgreSQL이 5432를 쓰는 경우와 충돌을 피하기 위해서다.
POSTGRES_PORT=5433
